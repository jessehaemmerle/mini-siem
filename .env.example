# Kopieren nach .env und anpassen. Alle Werte sind optional.

# Zeitzone für Geräte, die Syslog ohne Zeitzone senden (RFC 3164)
TZ=Europe/Vienna

# Erstes Admin-Konto. Ohne Passwort wird beim ersten Start eines erzeugt
# und im Container-Log angezeigt (docker compose logs siem).
SIEM_ADMIN_USER=admin
SIEM_ADMIN_PASSWORD=

# Standard-Aufbewahrung in Tagen (später in der Oberfläche änderbar)
SIEM_RETENTION_DAYS=90

# Syslog nur aus diesen Netzen annehmen (leer = alle), z. B. 10.0.0.0/8,192.168.0.0/16
SIEM_SYSLOG_ALLOW=

# Auf true setzen, wenn die Oberfläche über HTTPS (Reverse-Proxy) erreichbar ist
SIEM_COOKIE_SECURE=false

# Nur für die Anleitungen in der Oberfläche: Port, auf dem Syslog von außen erreichbar ist
SIEM_PUBLIC_SYSLOG_PORT=514

# IP-Adressen von Reverse-Proxys, deren X-Forwarded-For-Angaben vertraut wird
# (für korrekte Client-IPs im Protokoll), z. B. 172.16.0.0/12 oder *
SIEM_TRUSTED_PROXIES=127.0.0.1

# Adresse, unter der Agenten das SIEM erreichen, z. B. https://siem.firma.local
# (leer = Adresse, unter der die Oberfläche gerade aufgerufen wird). Steht in den
# Installationsbefehlen unter Quellen → Agenten.
SIEM_PUBLIC_URL=
